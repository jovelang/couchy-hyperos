<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV app: leanback required, no touchscreen needed -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- A launcher must see every launchable app -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android requires location permission to reveal the current Wi-Fi SSID. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Wallpaper streaming, optional Apple wallpaper downloads and weather. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Close app from recents (best-effort; true force-stop lives in App info) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Show the system uninstall dialog -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="com.ts.launcher.permission.CONTROL_ADB_KEEPER" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/media_network_security"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.LiteTV"
        android:supportsRtl="true">

        <uses-library android:name="com.xiaomi.mitv.api" android:required="false" />
        <uses-library android:name="mitvmiddlewareimpl" android:required="false" />
        <service android:name=".RemoteKeyService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true" android:label="@string/remote_keys_service">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_keys" />
        </service>
        <provider android:name=".ConfigProvider" android:authorities="${applicationId}.config"
            android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".SystemIdleReceiver" android:exported="true" android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="com.duokan.intent.action.show.screensaver" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".ScreenSaverActivity" android:exported="true" android:permission="android.permission.DEVICE_POWER" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="${applicationId}.screensaver"
            android:screenOrientation="landscape" android:theme="@style/Theme.CouchySaver" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|uiMode">

            <!-- Home-screen replacement -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Visible in the stock TV launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Visible on phone/tablet launchers too (handy for testing) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
